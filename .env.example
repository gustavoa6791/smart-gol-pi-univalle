# Variables de entorno para Docker Compose (copia a .env y completa los valores)

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure AI Vision (OCR cédulas). Recurso Computer Vision o Azure AI services en Azure Portal.
# La clave de Speech NO sirve si el recurso es solo de voz.
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=
